        "justificativa": "Código localiza e extrai, IA confirma: instâncias e normas de inclusão (termos + registro)."
      },
      "ancoras_semanticas": [
        "Política institucional de inclusão com papéis e normativas definidos",
        "AEE, acessibilidade e inclusão",
        "atendimento educacional especializado",
