      "tipo": "prazo-normativo",
      "norma_anterior": null,
      "aplica_a": "Órgãos normativos dos sistemas de ensino (no IFPR, CONSUP e PROENS).",
      "regra": "Editar normas complementares para implementar a Resolução em até 180 dias da publicação.",
