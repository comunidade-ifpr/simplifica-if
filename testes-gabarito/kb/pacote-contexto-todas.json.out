          "dispositivo": "#art43",
          "papel": "fundamento"
        }
      ],
      "execucao": {
        "modo": "S",
        "justificativa": "Código localiza e extrai, IA confirma: aplicabilidade e trecho de certificação de conhecimentos."
      },
      "ancoras_semanticas": [
