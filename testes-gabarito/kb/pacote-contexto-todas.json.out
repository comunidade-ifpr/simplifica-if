    {
      "id": "dcnept-2021-art63",
      "norma_id": "br/cne-cp/res/2021/1",
      "dispositivo": "#art63",
      "tipo": "faculdade-de-adequacao",
      "norma_anterior": null,
      "aplica_a": "Processos de autorização de cursos de EPT de graduação em tramitação, fora da fase de avaliação.",
      "regra": "Podem ser adequados à Res. CNE/CP nº 1/2021 por solicitação da instituição.",
      "situacao": "a confirmar",
      "inicio": "vigencia",
      "inicio_em": null,
      "inicio_minimo": "2021-01-05",
      "fim": "sem-prazo",
      "fim_em": null,
      "texto": "Art. 63. Os processos de autorização de cursos de Educação Profissional Tecnológica de Graduação em tramitação nos órgãos competentes e que ainda não estejam na fase de avaliação, podem ser, sem prejudicar a continuidade do processo, por solicitação da instituição, adequados a esta Resolução.",
      "path": "base-conhecimento/normas/br/resolucoes/RESOLUCAO_CNE-CP_1-2021_dcnept.md",
