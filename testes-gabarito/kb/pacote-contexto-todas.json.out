          "dispositivo": "#art28-xviii",
          "papel": "fundamento"
        },
        {
          "ref": "br/cne-cp/res/2026/2",
          "dispositivo": "#art28-par4",
          "papel": "fundamento"
        },
        {
          "ref": "br/cne-cp/res/2026/2",
          "dispositivo": "#art67",
          "papel": "fundamento"
        }
      ],
