  "transicoes": [
    {
      "id": "dcnept-2026-art70",
      "norma_id": "br/cne-cp/res/2026/2",
      "dispositivo": "#art70",
      "tipo": "faculdade-de-adequacao",
      "norma_anterior": "br/cne-cp/res/2021/1",
      "aplica_a": "Processos de autorização de cursos técnicos e de cursos superiores de tecnologia em tramitação, que ainda não estejam na fase de avaliação.",
      "regra": "Podem ser adequados à Res. CNE/CP nº 2/2026 por solicitação da instituição ou do órgão regulador; a adequação é facultativa e não prejudica a continuidade do processo.",
      "situacao": "a confirmar",
      "inicio": "vigencia",
      "inicio_em": null,
      "inicio_minimo": "2026-11-11",
      "fim": "sem-prazo",
      "fim_em": null,
      "texto": "Art. 70. Os processos de autorização de cursos técnicos e de cursos superiores de tecnologia em tramitação nos órgãos competentes, e que ainda não estejam na fase de avaliação, podem ser adequados a esta Resolução por solicitação da instituição ou do órgão regulador do sistema de ensino, sem prejudicar a continuidade do processo de autorização e credenciamento.",
      "path": "base-conhecimento/normas/br/resolucoes/RESOLUCAO_CNE-CP_2-2026_dcnept.md",
      "linha_inicio": 1070,
      "linha_fim": 1072
    },
    {
      "id": "dcnept-2026-art71",
      "norma_id": "br/cne-cp/res/2026/2",
      "dispositivo": "#art71",
      "tipo": "prazo-de-adequacao",
      "norma_anterior": "br/cne-cp/res/2021/1",
      "aplica_a": "Cursos técnicos e cursos superiores de tecnologia autorizados e em oferta.",
      "regra": "Período de transição de até dois anos, a partir da vigência da Res. CNE/CP nº 2/2026, para a adequação dos cursos.",
      "situacao": "a confirmar",
      "inicio": "vigencia",
      "inicio_em": null,
      "inicio_minimo": "2026-11-11",
      "fim": "P2Y",
      "fim_em": null,
      "texto": "Art. 71. Para a adequação dos cursos técnicos e cursos superiores de tecnologia autorizados e em oferta é assegurado período de transição de até dois anos, a partir da vigência desta Resolução.",
      "path": "base-conhecimento/normas/br/resolucoes/RESOLUCAO_CNE-CP_2-2026_dcnept.md",
      "linha_inicio": 1074,
      "linha_fim": 1076
    },
    {
      "id": "dcnept-2026-art71-parunico",
      "norma_id": "br/cne-cp/res/2026/2",
      "dispositivo": "#art71-parunico",
