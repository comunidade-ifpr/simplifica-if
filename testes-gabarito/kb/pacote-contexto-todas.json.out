      "tipo": "ementas",
      "titulo": "COMPONENTE CURRICULAR: Prática Clínica Simulada",
      "path": "base-conhecimento/institucional/ifpr/ppcs/curitiba/tecnico-em-enfermagem.md",
      "linha_inicio": 1053,
