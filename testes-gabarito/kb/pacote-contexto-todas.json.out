          "papel": "complementar"
        }
      ],
      "execucao": {
        "modo": "J",
        "justificativa": "Julgamento da IA: campos de estágio × perfil."
      },
      "ancoras_semanticas": [
        "Campos de estágio e equivalência coerentes com o perfil profissional",
