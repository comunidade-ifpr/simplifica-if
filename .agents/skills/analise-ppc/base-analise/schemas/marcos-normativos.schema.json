{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplifica-if.local/analise-ppc/marcos-normativos.schema.json",
  "title": "Registro de marcos normativos",
  "type": "object",
  "required": ["versao", "descricao", "marcos"],
  "properties": {
    "versao": { "type": "integer", "minimum": 1 },
    "descricao": { "type": "string" },
    "marcos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tema",
          "vigente",
          "aplica_a",
          "substitui",
          "antecessoras_historicas",
          "dispositivos_revogados",
          "fichas_responsaveis",
          "fichas_base_legal",
          "transicao",
          "orientacao_analise"
        ],
        "properties": {
          "id": { "type": "string" },
          "tema": { "type": "string" },
          "vigente": { "type": "string" },
          "aplica_a": { "type": "string" },
          "substitui": { "type": "array", "items": { "type": "string" } },
          "antecessoras_historicas": { "type": "array", "items": { "type": "string" } },
          "dispositivos_revogados": { "type": "array", "items": { "type": "string" } },
          "fichas_responsaveis": { "type": "array", "items": { "type": "string" } },
          "fichas_base_legal": { "type": "array", "items": { "type": "string" } },
          "transicao": { "type": "string" },
          "orientacao_analise": { "type": "string" }
        }
      }
    }
  }
}
