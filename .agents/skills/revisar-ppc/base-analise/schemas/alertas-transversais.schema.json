{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplifica-if.local/revisar-ppc/alertas-transversais.schema.json",
  "title": "Alertas transversais PPC",
  "description": "Gerado de .agents/skills/revisar-ppc/scripts/esquemas.ts (Effect Schema) por `revisar_ppc.ts gerar-schemas`; não edite à mão.",
  "type": "object",
  "properties": {
    "alertas_transversais": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "validacao_id": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "criticidade": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "BLOQ",
                  "OBRIG",
                  "REC"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "descricao": {
            "type": "string"
          },
          "fichas_relacionadas": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "evidencias": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "trecho": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "secao": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "localizador": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "papel": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "fonte": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "anchor": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "block_id": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "quote": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "revisao_humana_obrigatoria": {
            "type": "boolean"
          }
        },
        "required": [
          "validacao_id",
          "titulo",
          "descricao",
          "revisao_humana_obrigatoria"
        ],
        "allOf": [
          {
            "type": "object",
            "additionalProperties": {}
          }
        ]
      }
    }
  },
  "required": [
    "alertas_transversais"
  ],
  "allOf": [
    {
      "type": "object",
      "additionalProperties": {}
    }
  ]
}
