{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplifica-if.github.io/base-conhecimento/schemas/registros/conselho.schema.json",
  "title": "Conselho superior do IFPR",
  "description": "Formato de institucional/ifpr/conselhos/<conselho_id>/conselho.json. Gerado do Effect Schema de scripts/dados/ por scripts/gerar_base.ts; não edite à mão. As regras entre registros (chaves e relações) ficam na validação da base.",
  "type": "object",
  "properties": {
    "conselho_id": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "sigla": {
      "type": "string"
    },
    "situacao": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ]
    },
    "pagina_oficial": {
      "type": "string",
      "pattern": "^https://"
    }
  },
  "required": [
    "conselho_id",
    "nome",
    "sigla",
    "situacao",
    "pagina_oficial"
  ],
  "additionalProperties": false
}
