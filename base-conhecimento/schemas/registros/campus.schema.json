{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplifica-if.github.io/base-conhecimento/schemas/registros/campus.schema.json",
  "title": "Campus do IFPR",
  "description": "Formato de institucional/ifpr/campi/<campus_id>.json. Gerado do Effect Schema de scripts/dados/ por scripts/gerar_base.ts; não edite à mão. As regras entre registros (chaves e relações) ficam na validação da base.",
  "type": "object",
  "properties": {
    "campus_id": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "site": {
      "type": "string"
    },
    "calendario_academico": {
      "type": "string"
    },
    "horarios_url": {
      "type": "string"
    },
    "horarios_coletado_em": {
      "type": "string"
    }
  },
  "required": [
    "campus_id",
    "nome"
  ],
  "additionalProperties": false
}
