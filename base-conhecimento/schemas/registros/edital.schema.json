{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplifica-if.github.io/base-conhecimento/schemas/registros/edital.schema.json",
  "title": "Edital de ingresso do IFPR",
  "description": "Formato de institucional/ifpr/editais/<edital_id>.json. Gerado do Effect Schema de scripts/dados/ por scripts/gerar_base.ts; não edite à mão. As regras entre registros (chaves e relações) ficam na validação da base.",
  "type": "object",
  "properties": {
    "edital_id": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "numero": {
      "type": "string"
    },
    "ano": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "tipo": {
      "type": "string"
    },
    "processos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "edital_id",
    "titulo",
    "url",
    "processos"
  ],
  "additionalProperties": false
}
