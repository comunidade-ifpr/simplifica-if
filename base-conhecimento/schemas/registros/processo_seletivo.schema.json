{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplifica-if.github.io/base-conhecimento/schemas/registros/processo_seletivo.schema.json",
  "title": "Processo seletivo do IFPR",
  "description": "Formato de institucional/ifpr/processos-seletivos/<processo_seletivo_id>.json. Gerado do Effect Schema de scripts/dados/ por scripts/gerar_base.ts; não edite à mão. As regras entre registros (chaves e relações) ficam na validação da base.",
  "type": "object",
  "properties": {
    "processo_seletivo_id": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "ano_ingresso": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "instituicao": {
      "type": "string"
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status_curadoria": {
      "type": "string"
    },
    "verificado_em": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "processo_seletivo_id",
    "nome",
    "fontes"
  ],
  "additionalProperties": false
}
