{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplifica-if.local/revisao-ppc/ficha.schema.json",
  "title": "Ficha de revisão de PPC",
  "description": "Gerado de scripts/base/revisao-ppc/esquemas.ts (Effect Schema) por `gerar_base.ts`; não edite à mão.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "dominio": {
      "type": "string",
      "enum": [
        "identidade",
        "curriculo",
        "suporte",
        "transversal"
      ]
    },
    "criticidade": {
      "type": "string",
      "enum": [
        "BLOQ",
        "OBRIG",
        "REC"
      ]
    },
    "execucao": {
      "type": "object",
      "properties": {
        "modo": {
          "type": "string",
          "enum": [
            "D",
            "S",
            "J"
          ],
          "description": "D: o código decide com a base (verificador em packages/ppc, sem IA); S: o código acha o trecho e a IA confirma em resposta curta; J: julgamento da IA sobre as seções"
        },
        "justificativa": {
          "type": "string",
          "minLength": 1,
          "description": "Por que a ficha está nesse modo: o que o código usa e o que sobra para a IA"
        }
      },
      "required": [
        "modo",
        "justificativa"
      ],
      "additionalProperties": false,
      "description": "Como a ficha é executada na revisão do app; uma ficha D precisa de verificador registrado em packages/ppc/src/verificadores"
    },
    "topicos_tematicos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tipo_escopo": {
      "type": "string",
      "enum": [
        "tematico",
        "multitematico",
        "transversal",
        "condicional"
      ]
    },
    "ancoras_semanticas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consultas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referencias_normativas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(?:(?:br\\/(?:lei|lc|decreto|decreto-lei|mp|ec)|(?:br|ifpr)\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/(?:res|portaria|nt|parecer|in|deliberacao))\\/(\\d{4})\\/([1-9]\\d*)|externo:[a-z0-9]+(?:[-.][a-z0-9]+)*(?:\\/[a-z0-9]+(?:[-.][a-z0-9]+)*)*|cnct:[a-z0-9]+(?:-[a-z0-9]+)*)$",
            "description": "ID canônico: norma (br/..., ifpr/...), stub, externo:... ou cnct:..."
          },
          "dispositivo": {
            "type": "string",
            "pattern": "^#(?:(?:anexo\\d+-)?art[1-9]\\d*[A-Z]*(?:-par(?:[1-9]\\d*[A-Z]*|unico))?(?:-[ivxlc]+[A-Z]?)?(?:-al-[a-z])?(?:-item\\d+)?|anexo\\d+(?:-item\\d+)?|secao\\d+)$",
            "description": "Um dispositivo do ato, como #art28-vii, #art28-par1-iv ou #art24-parunico"
          },
          "papel": {
            "type": "string",
            "enum": [
              "fundamento",
              "complementar"
            ],
            "description": "fundamento: a ficha aplica a regra; complementar: a ficha só remete à referência"
          },
          "nota": {
            "type": "string",
            "minLength": 1,
            "description": "Detalhe da citação que não cabe em ref e dispositivo"
          }
        },
        "required": [
          "ref",
          "papel"
        ],
        "additionalProperties": false
      },
      "description": "Uma entrada por dispositivo; entradas consecutivas da mesma norma e do mesmo papel formam uma citação no texto legível"
    },
    "pergunta": {
      "type": "string"
    },
    "rubrica": {
      "type": "string"
    },
    "boa_evidencia": {
      "type": "string"
    },
    "ma_evidencia": {
      "type": "string"
    },
    "escalonar_quando": {
      "type": "string"
    },
    "evidencia_minima": {
      "type": "integer",
      "minimum": 1
    },
    "estados_permitidos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ATENDE",
          "NAO_ATENDE",
          "INCONCLUSIVO",
          "NAO_APLICAVEL"
        ]
      }
    },
    "feedback_autores": {
      "type": "object",
      "properties": {
        "obrigatorio_quando_estado": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ATENDE",
              "NAO_ATENDE",
              "INCONCLUSIVO",
              "NAO_APLICAVEL"
            ]
          }
        },
        "orientacao": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "titulo",
    "dominio",
    "criticidade",
    "execucao",
    "topicos_tematicos",
    "tipo_escopo",
    "ancoras_semanticas",
    "consultas",
    "pergunta",
    "rubrica",
    "boa_evidencia",
    "ma_evidencia",
    "evidencia_minima",
    "estados_permitidos"
  ],
  "additionalProperties": false
}
