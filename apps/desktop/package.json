{
  "name": "@simplifica-if/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Simplifica IF: o app desktop (Electron) que inicia o servidor local e mostra a interface",
  "type": "module",
  "main": "dist/app/main.cjs",
  "scripts": {
    "garantir-electron": "node scripts/t3/ensure-electron-runtime.mjs",
    "dev": "node scripts/dev.ts",
    "build": "node scripts/construir.ts",
    "dist": "node scripts/empacotar.ts",
    "test": "vp test run --config ../../vite.config.ts --dir .",
    "typecheck": "effect-tsgo tsrs --noEmit"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@simplifica-if/contratos-app": "workspace:*",
    "@simplifica-if/server": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "electron": "44.10.1",
    "electron-builder": "26.16.1",
    "vite-plus": "catalog:"
  },
  "productName": "Simplifica IF"
}
