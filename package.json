{
  "name": "simplifica-if",
  "private": true,
  "type": "module",
  "scripts": {
    "base:gerar": "node scripts/gerar_base.ts",
    "base:indice-ppcs": "node scripts/gerar_indice_ppcs.ts",
    "base:validar": "node scripts/validar_base.ts",
    "base:site": "node scripts/gerar_site.ts",
    "base:tipos": "node scripts/gerar_tipos_schemas.ts",
    "kb": "node packages/kb/src/cli.ts",
    "kb:compilar": "node packages/kb/src/cli.ts compilar",
    "mcp": "node packages/mcp/src/cli.ts",
    "mcp:instrucoes": "node packages/mcp/scripts/gerar-instrucoes.ts",
    "mcp:executavel": "node packages/mcp/scripts/construir-executavel.ts",
    "motor:poc": "node packages/motor/scripts/poc.ts",
    "app:dev": "pnpm --filter @simplifica-if/desktop dev",
    "mcp:smoke": "cd packages/mcp && SIMPLIFICA_SMOKE=1 vp test run --config ../../vite.config.ts --dir . test/transversal",
    "avaliacao": "node scripts/avaliar.ts",
    "avaliacao:gabaritos": "node scripts/avaliacao/gabaritos/gerar.ts",
    "sei:sync": "node scripts/notion_atualizar_movimentacoes_sei.ts",
    "sei": "node packages/sei-cli/src/cli.ts",
    "sync:repos": "node scripts/sincronizar_repos.ts",
    "upstream:t3": "node scripts/upstream_t3.ts",
    "test": "vp test run && pnpm -r --workspace-concurrency=1 test",
    "typecheck": "effect-tsgo tsrs --noEmit && pnpm -r typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@notionhq/client": "5.31.1",
    "@simplifica-if/kb": "workspace:*",
    "ajv": "8.20.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "dotenv": "18.0.10",
    "effect": "catalog:",
    "entities": "8.1.0",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "pdfmake": "0.3.13",
    "sei-cli": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "catalog:",
    "@types/pdfmake": "0.3.3",
    "json-schema-to-typescript": "16.0.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@12.14.0"
}
