{
  "name": "simplifica-if",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "base:gerar": "node scripts/gerar_base.ts",
    "base:indice-ppcs": "node scripts/gerar_indice_ppcs.ts",
    "base:validar": "node scripts/validar_base.ts",
    "base:tipos": "node scripts/gerar_tipos_schemas.ts",
    "kb": "node packages/mcp/src/kb.ts",
    "kb:compilar": "node packages/mcp/src/kb.ts compilar",
    "mcp": "node packages/mcp/src/cli.ts",
    "mcp:executavel": "node packages/mcp/scripts/construir-executavel.ts",
    "fabrica": "node scripts/fabrica_atualizacao.ts",
    "motor:poc": "node packages/motor/scripts/poc.ts",
    "app:dev": "pnpm --filter @simplifica-if/desktop dev",
    "mcp:smoke": "cd packages/mcp && SIMPLIFICA_SMOKE=1 SIMPLIFICA_SMOKE_APENAS=1 vp test run test/transversal",
    "avaliacao:skill": "node scripts/avaliar_skill.ts",
    "sync:repos": "node scripts/sincronizar_repos.ts",
    "traces": "node scripts/traces.ts",
    "pendencias": "node scripts/pendencias.ts",
    "test": "vp test run && pnpm -r --filter '!./packages/effect-acp' --filter '!./packages/effect-codex-app-server' --workspace-concurrency=4 test",
    "test:base": "pnpm --filter @simplifica-if/ppc test:base",
    "test:browser": "pnpm --filter @simplifica-if/web test:browser",
    "typecheck": "effect-tsgo tsrs --noEmit && pnpm -r --filter '!./packages/effect-acp' --filter '!./packages/effect-codex-app-server' typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@simplifica-if/atualizacao": "workspace:*",
    "@simplifica-if/contratos-app": "workspace:*",
    "@simplifica-if/docx": "workspace:*",
    "@simplifica-if/kb": "workspace:*",
    "@simplifica-if/ppc": "workspace:*",
    "@simplifica-if/mcp": "workspace:*",
    "@simplifica-if/motor": "workspace:*",
    "effect": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "catalog:",
    "json-schema-to-typescript": "16.0.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@12.14.0"
}
