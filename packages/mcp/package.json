{
  "name": "@simplifica-if/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "packageManager": "bun@1.4.4",
  "bin": {
    "simplifica-mcp": "./src/cli.ts"
  },
  "scripts": {
    "mcp": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "bun fmt src test",
    "format:check": "bun fmt --check src test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@simplifica-if/kb": "workspace:*",
    "commander": "15.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
